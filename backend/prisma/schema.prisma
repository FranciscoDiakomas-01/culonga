generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Settings {
  id      String @id @default(uuid())
  percent Int
}

model Users {
  id                String            @id @default(uuid())
  name              String
  lastname          String
  profile           String?
  email             String            @unique
  password          String
  telefone          String            @unique
  status            Status            @default(PENDING)
  role              UserRole          @default(SELLER)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
  availableBalance  Int               @default(0)
  totalEarned       Int               @default(0)
  withdrawnAmount   Int               @default(0)
  totalTranfered    Int               @default(0)
  totatReciev       Int               @default(0)
  totalAfiliations  Int?              @default(0)
  afiliationsAmount Int               @default(0)
  Afiliates         Afiliates[]
  Bank              Bank[]
  Coupons           Coupon[]
  Integrations      Integration[]
  Notification      Notification[]
  Offer             Offer[]
  Payments          Payment[]
  products          Products[]
  ResetPassword     ResetPassword[]
  sentTransfers     Transfer[]        @relation("UserFrom")
  receivedTransfers Transfer[]        @relation("UserTo")
  verification      UserVerification? @relation("verification")
  Withdrawal        Withdrawal[]
}

model Transfer {
  id        String       @id @default(uuid())
  fromId    String?
  toId      String?
  amount    Int
  type      TransferType
  status    Status       @default(APROVED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  fromUser  Users?       @relation("UserFrom", fields: [fromId], references: [id])
  toUser    Users?       @relation("UserTo", fields: [toId], references: [id])
}

model Bank {
  id     String  @id @default(uuid())
  iban   String  @unique
  title  String
  image  String?
  userid String
  user   Users   @relation(fields: [userid], references: [id], onDelete: Cascade)
}

model ResetPassword {
  id        String   @id @default(uuid())
  userid    String
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())
  token     String
  user      Users    @relation(fields: [userid], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id        String   @id @default(uuid())
  bank      String
  iban      String
  userid    String
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  amount    Int
  fileURL   String?
  user      Users    @relation(fields: [userid], references: [id], onDelete: Cascade)
}

model UserVerification {
  id        String   @id @default(uuid())
  userId    String   @unique
  images    Json
  status    Status   @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      Users    @relation("verification", fields: [userId], references: [id], onDelete: Cascade)
}

model Offer {
  id        String   @id @default(uuid())
  productId String
  price     Int
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  title     String
  userid    String
  product   Products @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      Users    @relation(fields: [userid], references: [id], onDelete: Cascade)
}

model Products {
  id                       String           @id @default(uuid())
  productid                Int              @unique @default(autoincrement())
  title                    String           @unique
  userId                   String
  description              String?
  whatsappSuport           String?
  price                    Int
  garant                   Int              @default(7)
  orderbumps               String[]
  link                     String           @unique
  upsell                   String?
  category                 String?
  type                     String
  payment                  Int[]
  backredirect             String?
  status                   Status           @default(APROVED)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @default(now()) @updatedAt
  banner                   String?
  cover                    String?
  file                     String?
  pixelId                  String?
  totalPurchase            Int              @default(0)
  percentShare             Int              @default(0)
  totalAfiliations         Int?             @default(0)
  totalAfiliationsPurchase Int?             @default(0)
  Afiliates                Afiliates[]
  offers                   Offer[]
  checkout                 ProductCheckout?
  user                     Users            @relation(fields: [userId], references: [id])
}

model Afiliates {
  id             Int      @id @default(autoincrement())
  userId         String
  totalSells     Int      @default(0)
  totalPurchases Int      @default(0)
  productId      String
  link           String
  status         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  product        Products @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           Users    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, productId])
}

model ProductCheckout {
  id        String   @id @default(uuid())
  productId String   @unique
  bg        String?
  textColor String?
  timer     Json?
  btn       Json
  orderbump Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  product   Products @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Payment {
  uuid           String    @id @default(uuid())
  method         PayMethod
  status         Status    @default(PENDING)
  amount         Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  user           Json
  order          Int       @unique @default(autoincrement())
  orderbumps     String[]
  paypayCode     String?   @unique
  productId      String
  products       String[]
  userid         String
  product        Json?
  description    String?
  coupun         Json?
  afiliationused Boolean   @default(false)
  afiliationcode String?   @db.VarChar(255)
  User           Users     @relation(fields: [userid], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  title     String
  deepLink  String?
  message   String
  timestemp DateTime @default(now())
  read      Boolean  @default(false)
  userId    String
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Integration {
  id        String   @id @default(uuid())
  userid    String
  status    Status   @default(APROVED)
  platform  String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      Users    @relation(fields: [userid], references: [id], onDelete: Cascade)
}

model Coupon {
  id             String   @id @default(cuid())
  code           String   @unique
  description    String?
  discount       Int
  usedCount      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  active         Boolean  @default(true)
  userId         String
  totalPurchased Int      @default(0)
  User           Users    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Status {
  APROVED
  PENDING
  REJECTED
  CANCELED
  CREATED
  BANED
}

enum UserRole {
  ADMIN
  SELLER
}

enum PayMethod {
  EXPRESS
  REFERENCE
  PAYPAY
}

enum TransferType {
  INTERNAL
  EXTERNAL
}
